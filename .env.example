# Chuỗi kết nối Neon (nên dùng bản "pooled", có -pooler trong tên máy chủ)
DATABASE_URL=postgresql://user:pass@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
VOYAGE_API_KEY=
# Chuỗi ngẫu nhiên dài (>= 32 ký tự) để mã hóa API key Groq lưu trong database. Đừng đổi sau khi đã lưu khóa.
APP_SECRET=
# Gmail của quản trị viên đầu tiên: đăng ký bằng Gmail này sẽ tự thành admin đã duyệt
ADMIN_EMAIL=ban@gmail.com

# Không bắt buộc: khóa/model Groq mặc định (admin có thể đổi ngay trong giao diện)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
EMBED_MODEL=voyage-3.5

# Hạn mức gọi embedding. Mặc định theo gói Voyage CHƯA thanh toán (3 yêu cầu/phút, 10.000 token/phút).
# Sau khi thêm phương thức thanh toán ở Voyage, đặt theo hạn mức ghi trên trang Voyage của bạn để lập chỉ mục nhanh hơn.
EMBED_RPM=3
EMBED_TPM=10000

# Ngưỡng quét tệp trước khi lập chỉ mục (không bắt buộc)
MAX_FILE_MB=20
WARN_FILE_MB=8
WARN_CHUNKS=300
MAX_CHUNKS=1200
DB_LIMIT_MB=1024
